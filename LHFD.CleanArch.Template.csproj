<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>LHFD.CleanArch.Template</PackageId>
    <Version>1.0.1</Version>
    <Authors>Lucas Henrique Faria de Deus</Authors>
    <Description>Clean Architecture template with Entity Framework Core CRUD base.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    
    <RepositoryUrl>https://github.com/lucashfdeus/LHFD.CleanArch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>CleanArchitecture;Template;DotNet10;Web;API</PackageTags>
    
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="." />
  </ItemGroup>

  <ItemGroup>
    <Content Include="**\*" Exclude="bin\**;obj\**;.git\**;.vs\**;*.nupkg" />
  </ItemGroup>

</Project>