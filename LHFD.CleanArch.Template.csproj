<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>LHFD.CleanArch.Template</PackageId>
    <Version>1.0.2</Version>
    <Authors>Lucas Henrique Faria de Deus</Authors>
    <Company>LHFD</Company>
    <Description>Clean Architecture template with Entity Framework Core CRUD base for .NET 10.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    
    <PackageProjectUrl>https://github.com/lucashfdeus/LHFD.CleanArch.Template</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lucashfdeus/LHFD.CleanArch.Template</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <PackageTags>CleanArchitecture;Template;DotNet10;Web;API</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="**\*" Exclude="bin\**;obj\**;.git\**;.vs\**;*.nupkg" />
  </ItemGroup>

</Project>