<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>LHFD.CleanArch.Template</PackageId>
    <Version>1.0.0</Version>
    <Authors>Lucas Henrique Faria de Deus</Authors>
    <Description>Clean Architecture template with Entity Framework Core CRUD base.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SEU_USUARIO/LHFD.CleanArch.Template</RepositoryUrl>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="**\*" Exclude="bin\**;obj\**;.git\**;.vs\**;*.nupkg" />
  </ItemGroup>

</Project>