<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>LHFD.CleanArch.Infrastructure</PackageId>
		<Version>1.0.3</Version>
		<Authors>Lucas Henrique Faria de Deus</Authors>
		<Company>LHFD</Company>
		<Description>SDK completo de Arquitetura Limpa contendo Domínio Base, Repositório Genérico e Unit of Work para .NET 10.</Description>
		<PackageTags>dotnet;clean-architecture;repository;unitofwork;sdk;efcore</PackageTags>

		<PackageProjectUrl>https://github.com/lucashfdeus/LHFD.CleanArch.Template</PackageProjectUrl>
		<RepositoryUrl>https://github.com/lucashfdeus</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LHFD.CleanArch.Domain\LHFD.CleanArch.Domain.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>